

name?: string

origin?: string


main: kit: info: {
  title?: string
  version?: string

  # Short one-line description of the API's purpose, set by the top
  # transform: the spec's `info.summary` when present, else the first
  # prose sentence of `info.description` (leading markdown headings
  # stripped, capped). Downstream doc generators surface it as the SDK's
  # "what this API is" blurb. Unset when the spec offers no usable prose.
  summary?: string

  website?: string

  auth?: boolean

  security?: {
    scheme?: string
    type?: string
    in?: string
    name?: string
    prefix?: string
  }
}


main: kit: entity: &: {

  name: key()
  active: *true

  id?: {
    field: string
    name: string

    parts?: [ &: string ]
    sep?: string

    from?: &: string

  }

  fields: [ &: %entity-field ]

  relations: {
    ancestors: [ &: [ &: string ] ]
  }

  op: &: {
    name: string
    input: *'data'

    points: [ &: {
      contract?: { version: 2, id: string, source: string }
      live?: boolean | {}

      active: *true

      kind: *'http' | 'graphql'

      method: GET | PUT | POST | DELETE | PATCH | OPTIONS | HEAD

      orig: string

      segments: [ &: {
        lit?: string
        var?: string
      } ]


      graphql?: {
        optype: 'query' | 'mutation'
        field: string
        doc: string
        vars: [ &: {
          name: string
          from: string
          gqltype: string
        } ]
        page?: {
          style: string
          nodes: string
          cursor: string
          more: string
        }
      }

      # Every arg kind is one shape plus its own `kind` tag.
      args: {
        &: [ &: %point-args ]
        params?: [ &: {
          kind: 'param'
        }]
        query?: [ &: {
          kind: 'query'
        } ]
        header?: [ &: {
          kind: 'header'
        } ]
        cookie?: [ &: {
          kind: 'cookie'
        } ]
      }

      select: {
        param?: {}
        query?: {}
        header?: {}
        cookie?: {}
        '$action'?: string
      }

    } ]
  }
}


main: kit: flow: &: {
  active: *true
  name: key()

  param: {}

  step: [ &: {
    active: *true
    op: string
    match: {}
    data: {}
    input: {}
    spec: []
    valid: []
  } ]
}




main: kit: type: type({
  entity-field: %entity-field = {
    name: string
    req: boolean
    type: top
    active: *true

    # The spec's own one-line words for this field, from the property's
    # `description`. Set only when the spec supplies a non-empty string, so
    # an absent `short` means "the spec said nothing" rather than "apidef
    # dropped it". Generated per-entity tables render it as the Description
    # column. Since 7.2.
    short?: string

    readOnly?: boolean
    writeOnly?: boolean
    deprecated?: boolean
    format?: string
  }

  point-args: %point-args = {
    active: *true
    kind: string
    name: string
    orig?: string
    reqd: boolean
    type: top
    example?: top
  }
})
