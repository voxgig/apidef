
guide: entity: &: {
  active?: boolean
  name: key()

  path: &: {
    active?: boolean

     rename?: {
       param?: {}
     }

     op: &: {
       active?: boolean
       method: string
       
       transform?: {
         req?: top
         res?: top
       }
     }
  }

  # GraphQL guides key operations by schema root field instead of path.
  field?: &: {
    active?: boolean

    action?: {}

    rename?: {
      arg?: {}
    }

    op: &: {
      active?: boolean
      method?: string
      optype?: string

      transform?: {
        req?: top
        res?: top
      }
    }
  }
}




