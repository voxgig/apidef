# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 12
  metrics: count: path: 19
  metrics: count: method: 23

  entity: catalog_bundle: {
    path: "/catalog/bundles": {
      op: list: method: *GET
    }
    path: "/catalog/bundles/{bundle_id}": {
      op: update: method: *PUT
    }
  }

  entity: gadget: {
    path: "/shop/gadgets": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/shop/gadgets/{gadget_id}": {
      rename: param: "gadget_id": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
    }
  }

  entity: job: {
    path: "/jobs": {
      op: list: method: *GET
    }
    path: "/jobs/{job_id}/cancel": {
      action: "cancel": {}
      rename: param: "job_id": *"id"
      op: create: method: *POST
    }
  }

  entity: member: {
    path: "/teams": {
      op: list: method: *GET
    }
    path: "/teams/{team_id}": {
      op: load: method: *GET
      op: remove: method: *DELETE
    }
  }

  entity: org: {
    path: "/org": {
      op: load: method: *GET
    }
  }

  entity: plan: {
    path: "/plans": {
      op: list: method: *GET
    }
  }

  entity: purchase: {
    path: "/plans/{plan_id}/accounts": {
      op: list: method: *GET
    }
  }

  entity: report: {
    path: "/org/reports": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
    path: "/org/reports/{report_id}/rerun": {
      action: "rerun": {}
      rename: param: "report_id": *"id"
      op: create: method: *POST
    }
  }

  entity: shop: {
    path: "/shop": {
      op: load: method: *GET
    }
  }

  entity: star: {
    path: "/stars": {
      op: list: method: *GET
    }
    path: "/stars/{owner}/{repo}": {
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
  }

  entity: token: {
    path: "/user/tokens": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
    path: "/user/tokens/{slug}/refresh": {
      action: "refresh": {}
      op: update: method: *PUT
    }
  }

  entity: user: {
    path: "/user": {
      op: load: method: *GET
    }
  }

}