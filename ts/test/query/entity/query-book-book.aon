# Entity: book

main: kit: entity: book: {

  alias: field: {}

  fields: {
    author: {
      h: "Author"
      n: "author"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "book"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "QUERY /api/book"
            source: "openapi3"
            version: 2
          }
          m: "QUERY"
          o: "/api/book"
          s: [
            {
              lit: "api"
            }
            {
              lit: "book"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/book/{book_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "book_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/book/{book_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              book_id: "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "book"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
