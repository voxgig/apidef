# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 16
  metrics: count: path: 21
  metrics: count: method: 24

  entity: artwork: {
    path: "/{year}/auction/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: census: {
    path: "/{year}/census": {
      op: list: method: *GET
      op: list: transform: res: *("`body.records`")|top
      op: list: transform: page: total: *("`body.total`")|top
    }
  }

  entity: crew_member: {
    path: "/{year}/crew/{id}/member": {
      rename: param: "id": *"crew_id"
      op: create: method: *POST
      op: load: method: *GET
    }
  }

  entity: deposit: {
    path: "/{year}/vault": {
      op: create: method: *POST
    }
  }

  entity: fossil: {
    path: "/{year}/fossil/{id}": {
      op: load: method: *GET
    }
  }

  entity: gallery: {
    path: "/{year}/gallery": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
      op: list: transform: page: next: *("`body.next`")|top
    }
  }

  entity: greenhouse: {
    path: "/{year}/greenhouse": {
      op: create: method: *POST
    }
    path: "/{year}/greenhouse/{id}": {
      op: load: method: *GET
    }
  }

  entity: kennel: {
    path: "/{year}/kennel": {
      op: create: method: *POST
    }
  }

  entity: ledger: {
    path: "/{year}/ledger": {
      op: load: method: *GET
    }
  }

  entity: observation: {
    path: "/{year}/observation": {
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
      op: list: transform: page: total: *("`body.total`")|top
    }
  }

  entity: package: {
    path: "/{year}/metrics/package/{owner}": {
      rename: param: "owner": *"id"
      op: load: method: *GET
      op: load: transform: res: *("`body.packages`")|top
    }
  }

  entity: sample: {
    path: "/{year}/sample/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: site: {
    path: "/{year}/site/{id}": {
      op: load: method: *GET
    }
  }

  entity: tally: {
    path: "/{year}/survey": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
    path: "/{year}/survey/{id}/close": {
      rename: param: "id": *"survey_id"
      op: create: method: *POST
      op: create: transform: res: *("`body.data`")|top
    }
  }

  entity: taxon: {
    path: "/{year}/domain": {
      action: "domain": {}
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
      op: list: transform: page: total: *("`body.total`")|top
    }
    path: "/{year}/domain/{domain_id}/kingdom/{kingdom_id}": {
      action: "kingdom": {}
      op: load: method: *GET
    }
    path: "/{year}/domain/{id}": {
      action: "domain": {}
      op: load: method: *GET
      op: patch: method: *PATCH
    }
    path: "/{year}/domain/{id}/kingdom": {
      action: "kingdom": {}
      rename: param: "id": *"domain_id"
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
      op: list: transform: page: total: *("`body.total`")|top
    }
  }

  entity: token: {
    path: "/{year}/metrics/token/{owner}": {
      rename: param: "owner": *"id"
      op: load: method: *GET
      op: load: transform: res: *("`body.tokens`")|top
    }
  }

}