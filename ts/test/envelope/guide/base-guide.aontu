# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 6
  metrics: count: path: 8
  metrics: count: method: 10

  entity: domain: {
    path: "/{year}/domain": {
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
    }
    path: "/{year}/domain/{id}": {
      op: load: method: *GET
      op: patch: method: *PATCH
    }
  }

  entity: fossil: {
    path: "/{year}/fossil/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.collector`")|top
    }
  }

  entity: kingdom: {
    path: "/{year}/domain/{domain_id}/kingdom/{kingdom_id}": {
      rename: param: "kingdom_id": *"id"
      op: load: method: *GET
    }
    path: "/{year}/domain/{id}/kingdom": {
      rename: param: "id": *"domain_id"
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
    }
  }

  entity: observation: {
    path: "/{year}/observation": {
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
    }
  }

  entity: sample: {
    path: "/{year}/sample/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: site: {
    path: "/{year}/site/{id}": {
      op: load: method: *GET
    }
  }

}