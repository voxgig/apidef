# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 1
  metrics: count: path: 4
  metrics: count: method: 4

  entity: taxon: {
    path: "/domain": {
      action: "domain": {}
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
    }
    path: "/domain/{domain_id}/kingdom/{id}": {
      action: "kingdom": {}
      op: load: method: *GET
    }
    path: "/domain/{id}": {
      action: "domain": {}
      op: load: method: *GET
    }
    path: "/domain/{id}/kingdom": {
      action: "kingdom": {}
      rename: param: "id": *"domain_id"
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
    }
  }

}