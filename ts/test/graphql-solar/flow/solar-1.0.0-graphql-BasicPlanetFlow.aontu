# BasicPlanetFlow

main: kit: flow: BasicPlanetFlow:
{
  entity: "planet",
  kind: "basic",
  name: "BasicPlanetFlow",
  step: [
    {
      input: {
        ref: "planet_ref01"
      }

      match: {
        after: "after01",
        first: "first01",
        forbid: "forbid01",
        start: "start01",
        stop: "stop01",
        why: "why01"
      }

      op: "create"
    }

    {
      match: {
        after: "after01",
        first: "first01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "planet_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "planet_ref01",
        srcdatavar: "planet_ref01_data",
        suffix: "_up0",
        textfield: "kind"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-planet_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "planet_ref01",
        srcdatavar: "planet_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "planet01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-planet_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "planet_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "planet01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        after: "after01",
        first: "first01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "planet_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPlanetFlow"
}