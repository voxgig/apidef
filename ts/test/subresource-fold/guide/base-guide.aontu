  }

  entity: call_route_allowed_caller: {
    path: "/v2/call_routes/{call_route_id}/allowed_callers": {
      rename: param: "call_route_id": *"id"
      op: create: method: *POST
      op: create: transform: res: *("`body.allowed_caller`")|top
      op: list: method: *GET
      op: list: transform: res: *("`body.allowed_callers`")|top
    }
    path: "/v2/call_routes/{call_route_id}/allowed_callers/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.allowed_caller`")|top
      op: remove: method: *DELETE
      op: update: method: *PUT
      op: update: transform: res: *("`body.allowed_caller`")|top
    }
  }

  entity: call_route_option: {
    path: "/v2/call_routes/{call_route_id}/options/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.option`")|top
      op: remove: method: *DELETE
    }
  }

}