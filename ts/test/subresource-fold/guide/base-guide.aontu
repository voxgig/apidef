guide: {
  metrics: count: entity: 3
  metrics: count: path: 5
  metrics: count: method: 9

  entity: call_route: {
    path: "/v2/call_routes": {
      op: list: method: *GET
      op: list: transform: res: *("`body.call_routes`")|top
    }
    path: "/v2/call_routes/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.call_route`")|top
