# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 15
  metrics: count: path: 15
  metrics: count: method: 16

  entity: api: {
    path: "/api/find/{name}": {
      op: load: method: *GET
    }
  }

  entity: cat: {
    path: "/cat/{tag}": {
      op: load: method: *GET
    }
  }

  entity: catalogue: {
    path: "/catalogue/{currency}": {
      op: load: method: *GET
    }
  }

  entity: category: {
    path: "/categories/{category}": {
      rename: param: "category": *"id"
      op: load: method: *GET
    }
  }

  entity: emoji: {
    path: "/emoji/{group-name}": {
      rename: param: "group-name": *"group_name"
      op: load: method: *GET
    }
  }

  entity: joke: {
    path: "/random/joke/{category}": {
      op: load: method: *GET
    }
  }

  entity: label: {
    path: "/labels/{lang}": {
      rename: param: "lang": *"id"
      op: load: method: *GET
    }
  }

  entity: member: {
    path: "/members/lookup/{member_id}": {
      rename: param: "member_id": *"id"
      op: load: method: *GET
    }
  }

  entity: movie: {
    path: "/movies/search/{query}": {
      op: load: method: *GET
    }
  }

  entity: pokemon: {
    path: "/pokemon/{name}": {
      rename: param: "name": *"id"
      op: load: method: *GET
    }
  }

  entity: quote: {
    path: "/random/quote/{category}": {
      op: load: method: *GET
    }
  }

  entity: region: {
    path: "/regions/{country}": {
      op: load: method: *GET
    }
  }

  entity: riddle: {
    path: "/riddle/{category}": {
      op: load: method: *GET
    }
  }

  entity: setting: {
    path: "/settings/{type}": {
      rename: param: "type": *"id"
      op: load: method: *GET
      op: update: method: *PUT
    }
  }

  entity: team: {
    path: "/teams/{teamId}": {
      rename: param: "teamId": *"id"
      op: load: method: *GET
    }
  }

}