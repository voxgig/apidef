# Entity: comment

main: kit: entity: comment: {

  alias: field: {}

  fields: {
    body: {
      h: "Body"
      n: "body"
      r: true
      t: "`$STRING`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    issue: {
      h: "Issue"
      n: "issue"
      r: false
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST commentCreate"
            source: "graphql"
            version: 2
          }
          gq: {
            doc: "mutation CommentCreate($input: CommentCreateInput!) { commentCreate(input: $input) { comment { ...CommentFields } success } } fragment CommentFields on Comment { body createdAt id issue { id } }"
            field: "commentCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CommentCreateInput!"
                name: "input"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "commentCreate"
          t: {
            req: "`reqdata`"
            res: "`body.data.commentCreate.comment`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "POST commentDelete"
            source: "graphql"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          gq: {
            doc: "mutation CommentRemove($id: String!) { commentDelete(id: $id) { entityId success } }"
            field: "commentDelete"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          k: "graphql"
          m: "POST"
          o: "commentDelete"
          q: {
            exist: [
              "id"
            ]
          }
          t: {
            req: "`reqdata`"
            res: "`body.data.commentDelete`"
          }
        }
      ]
    }
  }



}
