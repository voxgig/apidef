# Entity: comment

main: kit: entity: comment: {

  alias: field: {}

  fields: [
    {
      name: "body"
      req: true
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "issue"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "comment"
  op: {
    create: {
      name: "create"
      points: [
        {
          graphql: {
            doc: "mutation CommentCreate($input: CommentCreateInput!) { commentCreate(input: $input) { comment { ...CommentFields } success } } fragment CommentFields on Comment { body createdAt id issue { id } }"
            field: "commentCreate"
            optype: "mutation"
            vars: [
              {
                from: ""
                gqltype: "CommentCreateInput!"
                name: "input"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "commentCreate"
          transform: {
            req: "`reqdata`"
            res: "`body.data.commentCreate.comment`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          graphql: {
            doc: "mutation CommentRemove($id: String!) { commentDelete(id: $id) { entityId success } }"
            field: "commentDelete"
            optype: "mutation"
            vars: [
              {
                from: "id"
                gqltype: "String!"
                name: "id"
              }
            ]
          }
          kind: "graphql"
          method: "POST"
          orig: "commentDelete"
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data.commentDelete`"
          }
        }
      ]
    }
  }



}
