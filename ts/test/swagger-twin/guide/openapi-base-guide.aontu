#   openapi-guide.aontu

guide: {
  metrics: count: entity: 3
  metrics: count: path: 6
  metrics: count: method: 8

  entity: note: {
    path: "/notes": {
      op: create: method: *POST
    }
    path: "/notes/{note_id}": {
      rename: param: "note_id": *"id"
      op: load: method: *GET
    }
  }

  entity: ticket: {
    path: "/tickets": {
      op: create: method: *POST
    }
  }

  entity: widget: {
    path: "/widgets": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/widgets/{widget_id}": {
      rename: param: "widget_id": *"id"
      op: load: method: *GET
      op: update: method: *PUT
    }
    path: "/widgets/{widget_id}/image": {
      action: "image": {}
      rename: param: "widget_id": *"id"
      op: create: method: *POST
    }
  }

}