# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 20
  metrics: count: path: 27
  metrics: count: method: 27

  entity: agent: {
    path: "/well-known/agent.json": {
      op: list: method: *GET
    }
  }

  entity: agent_card: {
    path: "/well-known/agent-card.json": {
      op: list: method: *GET
    }
    path: "/zzz/{id}/dbset": {
      rename: param: "id": *"zzz_id"
      op: list: method: *GET
    }
  }

  entity: artifact: {
    path: "/ids/contentIds/{contentId}": {
      rename: param: "contentId": *"content_id"
      op: load: method: *GET
    }
    path: "/ids/globalIds/{globalId}": {
      rename: param: "globalId": *"global_id"
      op: load: method: *GET
    }
  }

  entity: dbase: {
    path: "/zzz/dbase/{id}/history": {
      action: "history": {}
      op: create: method: *POST
    }
  }

  entity: dbn: {
    path: "/other/db": {
      op: load: method: *GET
    }
  }

  entity: dbset: {
    path: "/well-known/dbset/{id}": {
      op: load: method: *GET
    }
  }

  entity: dsn: {
    path: "/aaa/ds/{id}": {
      op: load: method: *GET
    }
  }

  entity: dsx: {
    path: "/aaa/dsx/{id}": {
      op: load: method: *GET
    }
  }

  entity: dtn: {
    path: "/zzz/dtn": {
      op: load: method: *GET
    }
  }

  entity: ledger: {
    path: "/aaa/ledger/{id}/history": {
      action: "history": {}
      op: create: method: *POST
    }
  }

  entity: mcp_tool: {
    path: "/well-known/mcp-tools": {
      op: list: method: *GET
      op: list: transform: res: *("`body.tools`")|top
    }
    path: "/well-known/mcp-tools/{groupId}/{artifactId}": {
      rename: param: "artifactId": *"artifact_id"
      rename: param: "groupId": *"group_id"
      op: load: method: *GET
    }
  }

  entity: schema: {
    path: "/well-known/schemas/{schemaType}/{version}": {
      rename: param: "schemaType": *"schema_type"
      op: load: method: *GET
    }
  }

  entity: vault: {
    path: "/well-known/vault/{id}": {
      op: load: method: *GET
    }
  }

  entity: well_known_agent: {
    path: "/well-known/agents": {
      op: list: method: *GET
      op: list: transform: res: *("`body.agents`")|top
    }
    path: "/well-known/agents/{groupId}/{artifactId}": {
      rename: param: "artifactId": *"artifact_id"
      rename: param: "groupId": *"group_id"
      op: load: method: *GET
    }
  }

  entity: well_known_db: {
    path: "/well-known/db": {
      action: "db": {}
      op: load: method: *GET
    }
    path: "/well-known/db/{id}": {
      op: load: method: *GET
    }
  }

  entity: well_known_dbase: {
    path: "/well-known/dbase": {
      action: "dbase": {}
      op: load: method: *GET
    }
    path: "/well-known/dbase/{id}": {
      op: load: method: *GET
    }
  }

  entity: well_known_ds: {
    path: "/well-known/ds/{id}": {
      op: load: method: *GET
    }
  }

  entity: well_known_dt: {
    path: "/well-known/dt/{id}": {
      op: load: method: *GET
    }
  }

  entity: well_known_ledger: {
    path: "/well-known/ledger/{id}": {
      op: load: method: *GET
    }
  }

  entity: widget: {
    path: "/zzz/vault/{id}": {
      op: load: method: *GET
    }
    path: "/zzz/vault/{id}/merge": {
      action: "merge": {}
      rename: param: "id": *"vault_id"
      op: create: method: *POST
    }
  }

}