# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 9
  metrics: count: path: 10
  metrics: count: method: 10

  entity: branch: {
    path: "/branches": {
      op: list: method: *GET
      op: list: transform: res: *("`body.branches`")|top
    }
  }

  entity: document: {
    path: "/documents/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: export: {
    path: "/exports": {
      op: create: method: *POST
      op: create: transform: res: *("`body.data`")|top
    }
  }

  entity: job: {
    path: "/jobs": {
      op: create: method: *POST
      op: create: transform: res: *("`body.data`")|top
    }
    path: "/jobs/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: metric: {
    path: "/metrics": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
  }

  entity: notification: {
    path: "/notifications": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
  }

  entity: preference: {
    path: "/preferences": {
      op: list: method: *GET
      op: list: transform: res: *("`body.workflows`")|top
    }
  }

  entity: rollup: {
    path: "/rollups": {
      op: list: method: *GET
    }
  }

  entity: timeline: {
    path: "/timeline": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
  }

}