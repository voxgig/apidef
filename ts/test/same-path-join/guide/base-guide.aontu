# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 3
  metrics: count: path: 4
  metrics: count: method: 7

  entity: secret: {
    path: "/orgs/{org}/vault/secrets": {
      rename: param: "org": *"org_id"
      op: list: method: *GET
    }
    path: "/orgs/{org}/vault/secrets/{secret_name}": {
      rename: param: "org": *"org_id"
      rename: param: "secret_name": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
    }
  }

  entity: vault_repository_access_detail: {
    path: "/orgs/{org}/vault/repository-access": {
      rename: param: "org": *"org_id"
      op: load: method: *GET
      op: patch: method: *PATCH
    }
  }

  entity: widget: {
    path: "/widgets/{widget_id}": {
      rename: param: "widget_id": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
    }
  }

}