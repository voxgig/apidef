{
 "openapi": "3.0.0",
 "info": {
  "title": "item-download",
  "version": "1.0.0"
 },
 "servers": [
  {
   "url": "https://example.com"
  }
 ],
 "paths": {
  "/shelves/{shelfId}": {
   "get": {
    "parameters": [
     {
      "name": "shelfId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Shelf"
        }
       }
      }
     }
    }
   }
  },
  "/shelves/{shelfId}/books": {
   "get": {
    "parameters": [
     {
      "name": "shelfId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Book"
         }
        }
       }
      }
     }
    }
   }
  },
  "/shelves/{shelfId}/books/{bookId}": {
   "get": {
    "parameters": [
     {
      "name": "shelfId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "bookId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "*/*": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     }
    }
   },
   "put": {
    "parameters": [
     {
      "name": "shelfId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "bookId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Book"
        }
       }
      }
     }
    },
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Book"
       }
      }
     }
    }
   }
  },
  "/shelves/{shelfId}/cover/{width}": {
   "get": {
    "parameters": [
     {
      "name": "shelfId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "width",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Shelf": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    }
   },
   "Book": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    }
   }
  }
 }
}
