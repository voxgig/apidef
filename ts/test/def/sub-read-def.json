      "StoreStatus": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "last_sync": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          }
        }
