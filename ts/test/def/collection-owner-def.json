                  "items": {
                    "$ref": "#/components/schemas/Repository"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stars/{owner}/{repo}": {
      "put": {
        "operationId": "star-repo",
        "tags": [
          "activity"
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Starred"
          }
        }
      },
      "delete": {
        "operationId": "unstar-repo",
        "tags": [
          "activity"
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Unstarred"
          }
        }
      }
    },
    "/teams": {
      "get": {
        "operationId": "list-teams",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
