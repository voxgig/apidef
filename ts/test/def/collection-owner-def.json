                }
              }
            }
          }
        }
      }
    },
    "/catalog/bundles/{bundle_id}": {
      "put": {
        "operationId": "pushCatalogBundle",
        "tags": [
          "CatalogBundles"
        ],
        "parameters": [
          {
            "name": "bundle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogBundlePushRequest"
              }
