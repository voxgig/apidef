        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/catalog/bundles": {
      "get": {
        "operationId": "listCatalogBundles",
        "tags": [
          "CatalogBundles"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogBundle"
