                }
              }
            }
          }
        }
      }
    },
    "/user/tokens": {
      "get": {
        "operationId": "list-user-tokens",
        "tags": [
          "user"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Token"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/tokens/{slug}/refresh": {
      "put": {
        "operationId": "refresh-token",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          }
        }
      }
    },
    "/stars": {
      "get": {
        "operationId": "list-stars",
        "responses": {
          "200": {
            "description": "OK",
