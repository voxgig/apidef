{
  "openapi": "3.0.3",
  "info": {
    "title": "Verb Edge API",
    "version": "1.0.0",
    "description": "Fixture: edge cases of the verb-on-parent rule. The item path spells its key differently from the verb path; a PUT on the item answers with a one-off acknowledgement; a create-only nested collection stays an entity; a verb that is a suffix of its parent's name is still recorded as an action."
  },
  "servers": [
    {
      "url": "https://verb-edge.example.com"
    }
  ],
