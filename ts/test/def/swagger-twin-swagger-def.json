{
  "swagger": "2.0",
  "info": {
    "title": "Twin, Swagger 2",
    "version": "1.0.0"
  },
  "host": "api.example.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "responses": {
          "200": {
            "description": "The widgets.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Widget"
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWidget",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/WidgetInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The widget.",
            "schema": {
              "$ref": "#/definitions/Widget"
            }
          }
        }
      }
    },
    "/widgets/{widget_id}": {
      "get": {
        "operationId": "loadWidget",
        "parameters": [
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "The widget.",
            "schema": {
              "$ref": "#/definitions/Widget"
            }
          }
        }
      },
      "put": {
        "operationId": "updateWidget",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "widget": {
                  "$ref": "#/definitions/WidgetInput"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The widget.",
            "schema": {
              "$ref": "#/definitions/Widget"
            }
          }
        }
      }
    },
    "/widgets/{widget_id}/image": {
      "post": {
        "operationId": "uploadWidgetImage",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "widget_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caption",
            "in": "formData",
            "type": "string"
          },
          {
            "name": "file",
            "in": "formData",
            "required": true,
            "type": "file"
          }
        ],
        "responses": {
          "200": {
            "description": "The widget.",
            "schema": {
              "$ref": "#/definitions/Widget"
            }
          }
        }
      }
    },
    "/notes": {
      "post": {
        "operationId": "createNote",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NoteInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The note.",
            "schema": {
              "$ref": "#/definitions/Note"
            }
          }
        }
      }
    },
    "/notes/{note_id}": {
      "get": {
        "operationId": "loadNote",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "The note.",
            "schema": {
              "$ref": "#/definitions/Note"
            }
          }
        }
      }
    },
    "/tickets": {
      "post": {
        "operationId": "createTicket",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "parameters": [
          {
            "name": "title",
            "in": "formData",
            "required": true,
            "type": "string"
          },
          {
            "name": "priority",
            "in": "formData",
            "type": "integer"
          },
          {
            "name": "notify",
            "in": "formData",
            "type": "boolean"
          }
        ],
        "responses": {
          "200": {
            "description": "The ticket.",
            "schema": {
              "$ref": "#/definitions/Ticket"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Widget": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "WidgetInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "secret_code": {
          "type": "string"
        }
      }
    },
    "Note": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "NoteInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "Ticket": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        }
      }
    }
  }
}
