{
  "openapi": "3.0.3",
  "info": {
    "title": "List records",
    "version": "1.0.0",
    "description": "A list page whose records sit beside an object named for the entity."
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "paths": {
    "/quote/random": {
      "get": {
        "operationId": "getRandomQuote",
        "summary": "Random quotes, with the episodes they come from",
        "responses": {
          "200": {
            "description": "The quote and its episodes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/competitions/{id}/scorers": {
      "get": {
        "operationId": "getCompetitionScorers",
        "summary": "The top scorers of a competition",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The competition, its season and its scorers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScorerList"
                }
              }
            }
          }
        }
      }
    },
    "/competitions/{id}": {
      "get": {
        "operationId": "getCompetition",
        "summary": "One competition",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The competition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Competition"
                }
              }
            }
          }
        },
        "tags": [
          "Competitions"
        ]
      }
    },
    "/competitions/{id}/matches": {
      "get": {
        "operationId": "getCompetitionMatches",
        "summary": "The matches of a competition",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The competition and its matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "filters": {
                      "type": "object",
                      "properties": {
                        "season": {
                          "type": "string"
                        }
                      }
                    },
                    "competition": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "utcDate": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Competitions"
        ]
      }
    },
    "/competitions/{id}/teams": {
      "get": {
        "operationId": "getCompetitionTeams",
        "summary": "The teams of a competition, on a composed page",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The competition and its teams, composed",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "filters": {
                          "type": "object",
                          "properties": {
                            "season": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "competition": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "name": {
                              "type": "string"
                            }
                          }
                        },
                        "teams": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Competitions"
        ]
      }
    },
    "/quote/{id}": {
      "get": {
        "operationId": "getQuote",
        "summary": "One quote, wrapped",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The quote",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quote": {
                      "$ref": "#/components/schemas/Quote"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "get": {
        "operationId": "listNotes",
        "summary": "Notes, under the entity's own name",
        "responses": {
          "200": {
            "description": "The notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "note": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Note"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QuoteResponse": {
        "type": "object",
        "properties": {
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Episode"
            }
          },
          "quote": {
            "$ref": "#/components/schemas/Quote"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Episode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Quote": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "generated": {
            "type": "string"
          }
        }
      },
      "ScorerList": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "filters": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer"
              }
            }
          },
          "competition": {
            "$ref": "#/components/schemas/Competition"
          },
          "season": {
            "$ref": "#/components/schemas/Season"
          },
          "scorers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scorer"
            }
          }
        }
      },
      "Competition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Season": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "startDate": {
            "type": "string"
          }
        }
      },
      "Scorer": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "integer"
          },
          "playerName": {
            "type": "string"
          }
        }
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          }
        }
      }
    }
  }
}
