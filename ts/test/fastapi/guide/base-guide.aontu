# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 3
  metrics: count: path: 6
  metrics: count: method: 8

  entity: insight: {
    path: "/api/v1/insights/": {
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.items`")|top
    }
    path: "/api/v1/insights/{insight_id}": {
      rename: param: "insight_id": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
    }
  }

  entity: prompt: {
    path: "/api/v1/prompts/": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
    path: "/api/v1/prompts/{prompt_id}": {
      rename: param: "prompt_id": *"id"
      op: load: method: *GET
    }
  }

  entity: tag: {
    path: "/api/v1/tags/": {
      op: list: method: *GET
    }
    path: "/api/v1/tags/{tag_id}": {
      rename: param: "tag_id": *"id"
      op: load: method: *GET
    }
  }

}