# BasicMoonFlow

main: kit: flow: BasicMoonFlow:
{
  entity: "moon",
  kind: "basic",
  name: "BasicMoonFlow",
  step: [
    {
      i: {
        ref: "moon_ref01"
      }

      m: {
        planet_id: "planet01"
      }

      o: "create"
    }

    {
      m: {
        planet_id: "planet01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "moon_ref01"
          }
        }
      ]
    }

    {
      d: {
        planet_id: "planet01"
      }

      i: {
        ref: "moon_ref01",
        srcdatavar: "moon_ref01_data",
        suffix: "_up0",
        textfield: "kind"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-moon_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "moon_ref01",
        srcdatavar: "moon_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "moon01",
        planet_id: "planet01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-moon_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "moon_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "moon01",
        planet_id: "planet01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        planet_id: "planet01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "moon_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMoonFlow"
}