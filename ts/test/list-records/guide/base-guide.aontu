# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 6
  metrics: count: path: 10
  metrics: count: method: 10

  entity: competition: {
    path: "/competitions/{id}": {
      op: load: method: *GET
    }
    path: "/competitions/{id}/matches": {
      action: "match": {}
      op: list: method: *GET
      op: list: transform: res: *("`body.matches`")|top
      op: list: transform: page: total: *("`body.count`")|top
    }
    path: "/competitions/{id}/teams": {
      action: "team": {}
      op: list: method: *GET
      op: list: transform: res: *("`body.teams`")|top
      op: list: transform: page: total: *("`body.count`")|top
    }
  }

  entity: note: {
    path: "/notes": {
      op: list: method: *GET
      op: list: transform: res: *("`body.note`")|top
      op: list: transform: page: total: *("`body.total`")|top
    }
  }

  entity: quote: {
    path: "/quote/random": {
      action: "random": {}
      op: list: method: *GET
      op: list: transform: res: *("`body.episodes`")|top
    }
    path: "/quote/{id}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.quote`")|top
    }
  }

  entity: scorer: {
    path: "/competitions/{id}/scorers": {
      rename: param: "id": *"competition_id"
      op: list: method: *GET
      op: list: transform: res: *("`body.scorers`")|top
      op: list: transform: page: total: *("`body.count`")|top
    }
  }

  entity: user: {
    path: "/users": {
      op: list: method: *GET
      op: list: transform: res: *("`body.users`")|top
    }
  }

  entity: user_role: {
    path: "/user-roles": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
    path: "/users/{id}/user-role": {
      rename: param: "id": *"user_id"
      op: list: method: *GET
      op: list: transform: res: *("`body.user_role`")|top
    }
  }

}