# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 16
  metrics: count: path: 19
  metrics: count: method: 20

  entity: alert: {
    path: "/alerts": {
      op: create: method: *POST
    }
  }

  entity: batch: {
    path: "/batches": {
      op: create: method: *POST
    }
  }

  entity: broadcast: {
    path: "/broadcasts": {
      op: create: method: *POST
    }
  }

  entity: event: {
    path: "/events": {
      op: create: method: *POST
    }
  }

  entity: form: {
    path: "/forms": {
      op: create: method: *POST
    }
  }

  entity: item: {
    path: "/items": {
      op: create: method: *POST
    }
  }

  entity: label: {
    path: "/labels": {
      op: create: method: *POST
    }
  }

  entity: lookup: {
    path: "/lookups": {
      op: list: method: *QUERY
    }
  }

  entity: mark: {
    path: "/marks": {
      op: create: method: *POST
    }
  }

  entity: message: {
    path: "/mms/v1/messages": {
      op: create: method: *POST
    }
  }

  entity: notice: {
    path: "/notices": {
      op: create: method: *POST
    }
  }

  entity: record: {
    path: "/records": {
      op: create: method: *POST
    }
  }

  entity: session: {
    path: "/sessions": {
      op: remove: method: *DELETE
    }
    path: "/sessions/{session_id}": {
      rename: param: "session_id": *"id"
      op: load: method: *GET
    }
  }

  entity: tag: {
    path: "/tags": {
      op: create: method: *POST
    }
  }

  entity: user: {
    path: "/users": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/users/batch": {
      action: "batch": {}
      op: create: method: *POST
    }
    path: "/users/{user_id}": {
      rename: param: "user_id": *"id"
      op: load: method: *GET
    }
  }

  entity: widget: {
    path: "/widgets": {
      op: create: method: *POST
    }
  }

}