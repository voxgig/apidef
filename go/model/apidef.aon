

# ---------------------------------------------------------------------------
# ROOT IDENTITY
#
# `name` is the SDK's own name — the single input every generated IDENTIFIER
# is built from. apidef expands it into the case variants (Name, NAME, name_,
# name-) via names(model, model.name), and downstream generators turn those
# into class names, entity types and package identifiers.
#
# It is deliberately NOT the repo name, and NOT the published package name.
# Those are separate concerns, declared separately — see the SDK IDENTITY
# note in @voxgig/sdkgen's model/sdkgen.aontu. Both default to derivations of
# `name`, but a project may need all three to differ: renaming the slug to
# fix a repo path is what silently renames every public class.
#
# Declared here because apidef is the first consumer of `name`, and because
# an undeclared field carries no documentation to the projects that set it.
#
# OPTIONAL, deliberately. apidef is also run on definitions that carry no SDK
# identity at all (the GraphQL fixtures, for one), and a required `name` — or
# an `origin` with a default — would either fail to unify or inject identity
# into models that have none. These declare intent; they do not impose it.
name?: string

# Publisher slug: the git org that hosts the source, and the scope that
# published packages sit under. Consumers default it to 'voxgig-sdk'.
origin?: string


main: kit: info: {
  title?: string
  version?: string

  # Short one-line description of the API's purpose, set by the top
  # transform: the spec's `info.summary` when present, else the first
  # prose sentence of `info.description` (leading markdown headings
  # stripped, capped). Downstream doc generators surface it as the SDK's
  # "what this API is" blurb. Unset when the spec offers no usable prose.
  summary?: string

  # Canonical link back to the API's own website, set by the top
  # transform: `externalDocs.url`, else the redoc `x-logo.href`, else the
  # homepage derived from the primary server host (stripping an `api.` /
  # `developer.` / `docs.` subdomain), else `contact.url` / termsOfService.
  # Doc generators link to it so readers can reach the source API.
  website?: string

  # Set to false by the top transform when the spec declares no
  # authentication (no security schemes / security requirements). sdkgen's
  # isAuthActive() reads this to suppress apikey/auth code and docs. Left
  # unset when the API does declare auth.
  auth?: boolean

  # Spec-derived description of the API's primary security scheme, set by
  # the top transform when the spec declares auth. Downstream generators
  # read `prefix` (via sdkgen's resolveAuthPrefix) to emit the correct
  # Authorization value format — e.g. Statuspage documents
  # `Authorization: OAuth <key>`, not the common `Bearer`. The SDK's own
  # config (main.kit.config.auth) still overrides when set.
  security?: {
    # Key of the chosen scheme in components.securitySchemes.
    scheme?: string
    # OpenAPI scheme type: apiKey | http | oauth2 | openIdConnect.
    type?: string
    # Where the credential goes: header | query | cookie.
    in?: string
    # Header/query/cookie parameter name (e.g. Authorization, X-API-Key).
    name?: string
    # Credential value prefix inside an Authorization header ('' = raw key).
    prefix?: string
  }
}


main: kit: entity: &: {

  name: key()
  active: *true

  # Present only when the spec models an id for this entity (response /
  # request schema declares one, or examples imply one). Public APIs that
  # return payloads without an id leave this undefined.
  id?: {
    field: string
    name: string

    # COMPOSITE IDENTITY — set only when the API addresses one record by
    # more than one path parameter, so no single parameter is the id.
    # github's repo is the case: GET /repos/{owner}/{repo} needs both, and
    # neither alone names a repository. The same shape covers three or more.
    #
    # `parts` lists those parameters in path order; `sep` joins them into
    # the single `id` an SDK entity carries, so the unitary-id design holds
    # for these entities too. A slash is safe as the separator because it
    # cannot occur inside one path segment — a literal slash in a value
    # arrives percent-encoded — so the join is never ambiguous and the split
    # never over-splits.
    #
    # Absent for an ordinary single-key entity, so downstream branches on
    # presence rather than on a parts length of one.
    parts?: [ string ]
    sep?: string

    # Where each part's value lives in a RESPONSE, as a dotted path into the
    # record: `{ owner: 'owner.login', repo: 'name' }` for github's repo,
    # whose response carries the owner as an object and the repository name
    # as `name`. A path parameter's name is not generally a response field's
    # name, and without this an SDK can address a record it was given the id
    # of but cannot work out the id of one the API just returned.
    #
    # Only resolved parts appear; an absent part means nothing in the spec
    # relates it to a response field.
    from?: {}
  }

  fields: [ &: {
    name: string
    req: boolean
    type: top
    active: *true

    # The spec's own one-line words for this field, from the property's
    # `description`. Set only when the spec supplies a non-empty string, so
    # an absent `short` means "the spec said nothing" rather than "apidef
    # dropped it". Generated per-entity tables render it as the Description
    # column. Since 7.2.
    short?: string

    # SPEC FACTS ABOUT THE FIELD ITSELF, carried through verbatim.
    #
    # These four are declared by OpenAPI on the property and were being
    # dropped. They are facts the spec states, not inferences: `readOnly` is
    # the difference between a field a client MAY send and one it may not,
    # which no other key in this record expresses, and a generator that
    # cannot see it necessarily puts server-assigned fields into the type a
    # caller fills in.
    #
    # PRESENT ONLY WHEN THE SPEC SAYS SO. The three booleans are set only
    # when the spec declares them TRUE — each defaults to false in OpenAPI,
    # so an absent key and an explicit `false` mean the same thing, and
    # emitting the false ones would change every model for no information.
    # `format` is set only for a non-empty string.
    #
    # Where two schemas for one field disagree, the first declaration wins in
    # the same operation precedence `short` uses. See the transform.
    readOnly?: boolean
    writeOnly?: boolean
    deprecated?: boolean
    format?: string
  } ]

  relations: {
    ancestors: [ &: [ &: string ] ]
  }
  
  op: &: {
    name: string
    input: *'data'

    points: [ &: {

      active: *true
          
      # Transport discriminator. GraphQL points synthesize method 'POST'
      # and an empty segment list, so the HTTP shape below stays required.
      kind: *'http' | 'graphql'

      method: GET | PUT | POST | DELETE | PATCH | OPTIONS | HEAD

      orig: string

      # The path, resolved (ADR-003). Each segment is a literal or a
      # variable naming one of `args.params` — never a braced string for a
      # consumer to parse back out. Renames are already applied.
      segments: [ &: {
        lit?: string
        var?: string
      } ]

      # NO TOMBSTONE FOR `parts` HERE, and this is load-bearing.
      #
      # 8.2.0 declared `parts?: null` so that a model generated by apidef
      # <= 8.1 would fail to unify rather than take the empty `segments`
      # default and send every request to the API root. It caught exactly
      # that, and it also BRICKED the upgrade: a project's checked-in
      # `.sdk/model/entity/*.aon` IS the input to the tool that rewrites it,
      # and voxgig-model unifies before it runs apidef's build. So the stale
      # file blocked the regeneration that would have removed it, with no
      # supported way out — `voxgig-apidef` is still a stub.
      #
      # A schema cannot police its own migration. The guard belongs where a
      # stale point would actually do harm: sdkgen reads the path through one
      # helper, and that helper refuses a point carrying `parts` and no
      # `segments`. Same defect caught, at generation time, without
      # deadlocking the regeneration.

      # GraphQL wire data: the precomputed operation document plus the
      # variable bindings and (for list ops) the pagination descriptor.
      graphql?: {
        optype: 'query' | 'mutation'
        field: string
        doc: string
        vars: [ &: {
          name: string
          from: string
          gqltype: string
        } ]
        page?: {
          style: string
          nodes: string
          cursor: string
          more: string
        }
      }

      # Each arg kind (path params, query, header, cookie) has the same
      # element shape. `kind` is constrained to the kind tag matching the
      # array it appears in; `example` is optional and captures a spec-
      # provided example value used by test generators.
      args: {
        params?: [ &: {
          active: *true
          kind: 'param'
          name: string
          orig?: string
          reqd: boolean
          type: top
          example?: top
        } ]
        query?: [ &: {
          active: *true
          kind: 'query'
          name: string
          orig?: string
          reqd: boolean
          type: top
          example?: top
        } ]
        header?: [ &: {
          active: *true
          kind: 'header'
          name: string
          orig?: string
          reqd: boolean
          type: top
          example?: top
        } ]
        cookie?: [ &: {
          active: *true
          kind: 'cookie'
          name: string
          orig?: string
          reqd: boolean
          type: top
          example?: top
        } ]
      }

      select: {
        param?: {}
        query?: {}
        header?: {}
        cookie?: {}
        '$action'?: string
      }
      
    } ]
  }
}


main: kit: flow: &: {
  active: *true
  name: key()

  param: {}

  step: [ &: {
    active: *true
    op: string
    match: {}
    data: {}
    input: {}
    spec: []
    valid: []
  } ]
}
