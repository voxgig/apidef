

name?: string

origin?: string


main: kit: info: {
  title?: string
  version?: string

  # Short one-line description of the API's purpose, set by the top
  # transform: the spec's `info.summary` when present, else the first
  # prose sentence of `info.description` (leading markdown headings
  # stripped, capped). Downstream doc generators surface it as the SDK's
  # "what this API is" blurb. Unset when the spec offers no usable prose.
  summary?: string

  website?: string

  auth?: boolean

  security?: {
    scheme?: string
    type?: string
    in?: string
    name?: string
    prefix?: string
  }
}


main: kit: entity: &: {

  name: key()
  active: *true

  id?: {
    field: string
    name: string

    parts?: [ &: string ]
    sep?: string

    from?: &: string

  }

  fields: { &: %entity-field }

  relations: {
    ancestors: [ &: [ &: string ] ]
  }

  op: &: {
    name: string
    input: *'data'

    points: [ &: %op-points ]
  }
}


main: kit: flow: &: {
  active: *true
  name: key()

  param: {}

  step: [ &: %flow-step ]
}




main: kit: type: type({
  flow-step: %flow-step = {
    a: *true
    o: string
    m: {}
    d: {}
    i: {}
    s: []
    v: []
  }

  op-points: %op-points = {
    a: *true
    k: *'http' | 'graphql'
    m: GET | PUT | POST | DELETE | PATCH | OPTIONS | HEAD | QUERY
    o: string

    s: [ &: { lit?: string, var?: string } ]
    r: { param?: {}, query?: {}, header?: {}, cookie?: {} }
    t: { req?: top, res?: top }

    # Every arg kind is one shape plus its own `k` tag.
    g: {
      &: [ &: %point-args ]
      params?: [ &: { k: 'param' } ]
      query?: [ &: { k: 'query' } ]
      header?: [ &: { k: 'header' } ]
      cookie?: [ &: { k: 'cookie' } ]
    }

    q: {
      param?: {}
      query?: {}
      header?: {}
      cookie?: {}
      '$action'?: string
    }

    co?: { version: 2, id: string, source: string }
    li?: boolean | {}
    gq?: {
      optype: 'query' | 'mutation'
      field: string
      doc: string
      vars: [ &: { name: string, from: string, gqltype: string } ]
      page?: { style: string, nodes: string, cursor: string, more: string }
    }
  }

  entity-field: %entity-field = {
    n: key()
    h: string
    r: boolean
    t: top
    a: *true

    sh?: string

    ro?: boolean
    wo?: boolean
    de?: boolean
    fo?: string
  }

  point-args: %point-args = {
    a: *true
    k: string
    n: string
    or?: string
    r: boolean
    t: top
    ex?: top
  }
})
