
guide: entity: &: {
  active?: boolean
  name: key()

  id?: {
    parts?: [ &: string ]
    sep?: string
    composite?: boolean

    # Corrects WHERE A PART LIVES in a response, per part, so a spec can fix
    # one mapping without restating the others.
    from?: &: string

  }

  path: &: {
    active?: boolean

     # A non-CRUD verb on the path (`action: merge: {}`), declared beside a
     # CRUD op; the op's points then carry `select.$action`. The heuristic
     # emits these for trailing verbs, and guide.aon may add them.
     action?: {}

     rename?: {
       param?: {}
     }

     op: &: {
       # Declarative live input recipes and output/credential bindings.
       live?: boolean | {}
       contract?: {}
       active?: boolean
       method: string

       transform?: {
         req?: top
         res?: top
       }
     }
  }

  # GraphQL guides key operations by schema root field instead of path.
  field?: &: {
    active?: boolean

    action?: {}

    rename?: {
      arg?: {}
    }

    op: &: {
      live?: boolean | {}
      contract?: {}
      active?: boolean
      method?: string
      optype?: string

      transform?: {
        req?: top
        res?: top
      }
    }
  }
}




